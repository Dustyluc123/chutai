{
  "name": "@chutai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Banco de dados: tabelas (Drizzle), temas oficiais e repositórios. Funciona sem banco usando os JSON de seed.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx seed/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chutai/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
