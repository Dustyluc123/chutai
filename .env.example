# Copie este arquivo para .env e ajuste os valores.
# Nenhuma variável é obrigatória para rodar localmente: sem DATABASE_URL
# os temas vêm dos arquivos JSON em packages/db/seed e as partidas ficam só na memória.

# ---------- Site (apps/web) ----------
# Endereço do servidor de tempo real que o navegador vai usar.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# Endereço público do site, para os links das prévias (WhatsApp, redes) e do compartilhar.
# Na Vercel: https://chutai-bay.vercel.app (o de Domains).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chave secreta do sorteio do desafio diário (só no servidor do site, sem NEXT_PUBLIC_).
# Não tem valor padrão: sem ela, o diário mostra "indisponível". Gere com: openssl rand -hex 32
# NUNCA troque depois do lançamento: trocar muda todas as respostas, inclusive a de hoje.
# DAILY_SECRET=

# ---------- Servidor de tempo real (apps/realtime) ----------
PORT=3001
# Origens que podem se conectar (separe por vírgula).
CORS_ORIGIN=http://localhost:3000
# Imagens dos personagens para o modo Imagem. O servidor lê primeiro do disco (ASSETS_DIR,
# padrão: apps/web/public) e só busca no site (ASSETS_BASE_URL) o que não achar.
# ASSETS_DIR=/caminho/para/apps/web/public
ASSETS_BASE_URL=http://localhost:3000

# ---------- Banco de dados (futuro) ----------
# Quando existir, os temas passam a vir do PostgreSQL e as partidas terminadas são salvas.
# Local com Docker: docker compose up -d  →  postgres://chutai:chutai@localhost:5432/chutai
# DATABASE_URL=postgres://chutai:chutai@localhost:5432/chutai

# ---------- Redis (salas que sobrevivem a deploys) ----------
# Guarda a sala inteira (rodada, chutes, pontos, cronômetros). Depois de um reinício, a partida
# continua de onde parou. Sem ela, as salas ficam só na memória (desenvolvimento local).
# Local com Docker: docker compose --profile redis up -d
# REDIS_URL=redis://localhost:6379
# Id deste servidor como dono das salas (opcional; no Railway usa o id do deploy).
# INSTANCE_ID=

# ---------- Sentry (erros chegam até você; opcional) ----------
# Sem dados pessoais: sem usuário, IP, apelidos, chutes, cabeçalhos ou Session Replay.
# Site (navegador e servidor da Vercel). O DSN não é secreto (vai no código do navegador).
# NEXT_PUBLIC_SENTRY_DSN=
# Servidor de tempo real.
# SENTRY_DSN=
# Opcional, SECRETA: mapas do código no build do site (erros com o código original).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
