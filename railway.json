{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @chutai/realtime build",
    "watchPatterns": [
      "apps/realtime/**",
      "packages/**",
      "apps/web/public/temas/**",
      "package.json",
      "pnpm-lock.yaml",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/realtime/dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
